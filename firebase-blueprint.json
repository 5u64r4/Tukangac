{
  "entities": {
    "Customer": {
      "collection": "customers",
      "fields": {
        "id": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "phone": { "type": "string", "required": true },
        "email": { "type": "string", "required": false },
        "defaultAddress": { "type": "string", "required": false },
        "addressLabel": { "type": "string", "required": false },
        "totalOrders": { "type": "number", "required": true },
        "points": { "type": "number", "required": true },
        "createdAt": { "type": "string", "required": true },
        "updatedAt": { "type": "string", "required": true }
      }
    },
    "Order": {
      "collection": "orders",
      "fields": {
        "id": { "type": "string", "required": true },
        "customerName": { "type": "string", "required": true },
        "customerPhone": { "type": "string", "required": true },
        "serviceName": { "type": "string", "required": true },
        "unitCount": { "type": "number", "required": true },
        "complaint": { "type": "string", "required": false },
        "addressLabel": { "type": "string", "required": true },
        "fullAddress": { "type": "string", "required": true },
        "date": { "type": "string", "required": true },
        "timeSlot": { "type": "string", "required": true },
        "totalPrice": { "type": "number", "required": true },
        "status": { "type": "string", "required": true },
        "technicianName": { "type": "string", "required": false },
        "technicianId": { "type": "string", "required": false },
        "technicianRating": { "type": "number", "required": false },
        "technicianDistance": { "type": "string", "required": false },
        "createdAt": { "type": "string", "required": true },
        "estimatedArrival": { "type": "string", "required": false }
      }
    },
    "Technician": {
      "collection": "technicians",
      "fields": {
        "id": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "code": { "type": "string", "required": false },
        "phone": { "type": "string", "required": true },
        "email": { "type": "string", "required": false },
        "avatar": { "type": "string", "required": true },
        "photoUrl": { "type": "string", "required": false },
        "rating": { "type": "number", "required": true },
        "reviewCount": { "type": "number", "required": true },
        "isOnline": { "type": "boolean", "required": true },
        "activeOrders": { "type": "number", "required": true },
        "distance": { "type": "string", "required": true },
        "roleTitle": { "type": "string", "required": false },
        "vehiclePlate": { "type": "string", "required": false },
        "experienceYears": { "type": "string", "required": false },
        "totalEarnings": { "type": "number", "required": false }
      }
    },
    "TechnicianApplicant": {
      "collection": "technician_applicants",
      "fields": {
        "id": { "type": "string", "required": true },
        "name": { "type": "string", "required": true },
        "phone": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "domicile": { "type": "string", "required": true },
        "experienceYears": { "type": "string", "required": true },
        "education": { "type": "string", "required": true },
        "certifications": { "type": "array", "required": true },
        "skills": { "type": "array", "required": true },
        "appliedDate": { "type": "string", "required": true },
        "status": { "type": "string", "required": true },
        "notes": { "type": "string", "required": false },
        "ktpNumber": { "type": "string", "required": false }
      }
    },
    "AdminAuditLog": {
      "collection": "admin_audit_logs",
      "fields": {
        "id": { "type": "string", "required": true },
        "action": { "type": "string", "required": true },
        "role": { "type": "string", "required": true },
        "target": { "type": "string", "required": true },
        "details": { "type": "string", "required": true },
        "timestamp": { "type": "string", "required": true }
      }
    },
    "Article": {
      "collection": "articles",
      "fields": {
        "id": { "type": "string", "required": true },
        "title": { "type": "string", "required": true },
        "slug": { "type": "string", "required": true },
        "category": { "type": "string", "required": true },
        "summary": { "type": "string", "required": true },
        "status": { "type": "string", "required": true },
        "readTime": { "type": "string", "required": true },
        "date": { "type": "string", "required": true },
        "author": { "type": "object", "required": true },
        "image": { "type": "string", "required": true },
        "content": { "type": "object", "required": true },
        "tags": { "type": "array", "required": true },
        "views": { "type": "number", "required": false },
        "featured": { "type": "boolean", "required": false },
        "createdAt": { "type": "string", "required": true },
        "updatedAt": { "type": "string", "required": true }
      }
    },
    "OrderMessage": {
      "collection": "orders/{orderId}/messages",
      "fields": {
        "id": { "type": "string", "required": true },
        "orderId": { "type": "string", "required": true },
        "senderRole": { "type": "string", "required": true },
        "senderName": { "type": "string", "required": true },
        "senderAvatar": { "type": "string", "required": false },
        "text": { "type": "string", "required": true },
        "timestamp": { "type": "string", "required": true },
        "createdAt": { "type": "string", "required": true },
        "isRead": { "type": "boolean", "required": false }
      }
    }
  }
}
